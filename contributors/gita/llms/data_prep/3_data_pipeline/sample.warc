 justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles w-5 h-5 text-white" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></div><div><p class="text-white font-medium text-sm">Suggestion</p><p class="text-gray-400 text-xs">Based on &quot;Makossa Classics&quot;</p></div></div><div class="h-2 bg-gray-700 rounded-full w-full overflow-hidden"><div class="h-full bg-gradient-to-r from-blue-500 to-purple-500" style="width:0px"></div></div><p class="text-right text-xs text-blue-400 mt-1">98% Match</p></div></div></div></div></div></section><section id="festival" class="py-10 bg-[#0B0E14] scroll-mt-20"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="relative rounded-3xl overflow-hidden p-8 md:p-16 flex flex-col items-center text-center" style="opacity:0;transform:translateY(20px)"><div class="absolute inset-0 bg-gradient-to-br from-red-900 via-[#2A0505] to-black z-0"></div><div class="absolute top-0 right-0 w-64 h-64 bg-red-600/20 rounded-full blur-[80px] pointer-events-none"></div><div class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-600/10 rounded-full blur-[80px] pointer-events-none"></div><div class="relative z-10 max-w-3xl"><span class="text-red-400 font-semibold tracking-widest uppercase text-sm mb-4 block">Coming Soon</span><h2 class="text-3xl md:text-5xl font-bold text-white mb-6 font-serif">Maaval Heritage Festival</h2><p class="text-gray-300 text-lg mb-8 leading-relaxed">Join us in celebrating the diverse culture of the Sawa people through music, dance, digital arts, and culinary traditions. An immersive experience awaiting you.</p><div class="flex flex-col sm:flex-row gap-4 justify-center"><button class="px-8 py-3 bg-red-600 text-white rounded-full font-semibold hover:bg-red-700 transition-colors shadow-lg">Join the Waitlist</button><div class="flex items-center gap-4 text-gray-400 text-sm justify-center mt-4 sm:mt-0"><span class="flex items-center gap-1">• December 2026</span><span class="flex items-center gap-1">• Douala, CMR</span></div></div></div></div></div></section><footer class="bg-[#05070a] border-t border-gray-800 text-gray-400 py-12"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8"><div class="col-span-1 md:col-span-1"><div class="flex items-center group transition-all mb-4"><img alt="SawaFlix Logo" width="980" height="228" decoding="async" data-nimg="1" class="w-auto h-6 sm:h-7 md:h-7.5 rounded-md object-contain object-left group-hover:scale-105 transition-transform duration-300" style="color:transparent" srcSet="/_next/image?url=%2Flogos_and_pwas%2FheaderLogo..png&amp;w=1080&amp;q=75 1x, /_next/image?url=%2Flogos_and_pwas%2FheaderLogo..png&amp;w=2048&amp;q=75 2x" src="/_next/image?url=%2Flogos_and_pwas%2FheaderLogo..png&amp;w=2048&amp;q=75"/></div><p class="text-sm leading-relaxed mb-4">Your premium destination for Sawa cultural heritage. preserving our stories for future generations.</p><div class="flex gap-4"><a href="#" class="hover:text-red-500 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a><a href="#" class="hover:text-red-500 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fil